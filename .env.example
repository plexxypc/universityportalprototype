# Application
# Local copy only. Outside local, APP_DEBUG must be false and the boot check requires APP_KEY and APP_URL.
APP_NAME="University Portal"
APP_ENV=local
APP_KEY=
APP_URL=http://127.0.0.1:8000
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database
# Local Docker defaults. Leave DB_SSL_CA empty locally.
# For Aiven, set DB_SSL_CA to a CA file path or paste the certificate text.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=university_portal
DB_USERNAME=portal
DB_PASSWORD=portal
DB_SSL_CA=

# Sessions, cache, and queue
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Mail
# Use log locally. Demo and production may set MAIL_MAILER=brevo.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=

# Payments
# Demo gateway until the institution chooses Remita or Interswitch. No live credentials here.
PAYMENT_PROVIDER=demo
REMITA_ENV=demo
REMITA_MERCHANT_ID=
REMITA_SERVICE_TYPE_ID=
REMITA_API_KEY=
INTERSWITCH_MODE=TEST
INTERSWITCH_MERCHANT_CODE=
INTERSWITCH_PAY_ITEM_ID=
INTERSWITCH_CLIENT_ID=
INTERSWITCH_SECRET=

# Files
# local for development. Production uses s3 (or Spaces) and fills the keys in the host dashboard.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Demo seeder
# Used only by the seeder. Leave empty until that task.
DEMO_SEED_PASSWORD=
